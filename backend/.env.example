# ==============================================================================
# WARRIOR MARTIAL ARTS ACADEMY - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Django Core Security & Runtime
DJANGO_SECRET_KEY=your-production-secret-key-goes-here-keep-it-secret!
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost

# ==============================================================================
# FULL POSTGRESQL DATABASE CONFIGURATION STRUCTURE
# ==============================================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=martial_arts_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/martial_arts_db

# ==============================================================================
# CORS & FRONTEND ACCESS
# ==============================================================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173
