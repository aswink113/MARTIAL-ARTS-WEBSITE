[Unit]
Description=Gunicorn daemon for Warrior Martial Arts Django REST Backend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/martial-arts/backend
ExecStart=/var/www/martial-arts/backend/venv/bin/gunicorn \
          --workers 3 \
          --bind 127.0.0.1:8000 \
          --access-logfile /var/log/gunicorn/martial_arts_access.log \
          --error-logfile /var/log/gunicorn/martial_arts_error.log \
          core.wsgi:application

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
