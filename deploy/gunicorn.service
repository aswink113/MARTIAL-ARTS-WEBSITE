[Unit]
Description=Greentrack Martial Arts Django application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/martial-arts
EnvironmentFile=/var/www/martial-arts/.env
ExecStart=/var/www/martial-arts/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
